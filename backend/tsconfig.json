{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "outDir": "dist",
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "index.ts",
    "db.ts",
    "jwt.ts",
    "middleware.ts",
    "routes/**/*.ts",
    "prisma/**/*.ts",
    "prisma.config.ts",
    "lib/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".agents",
    ".claude",
    ".windsurf"
  ]
}
